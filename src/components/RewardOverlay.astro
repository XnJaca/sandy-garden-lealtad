---
/** Pantalla completa de celebración. El lienzo lo controla scripts/reward.ts (Three.js). */
---
<div class="reward-overlay" id="reward" hidden role="dialog" aria-modal="true" aria-labelledby="rTitle" data-logo="/img/logo-h-madera.png">
  <div class="sun"></div>
  <span class="rc rc1"></span><span class="rc rc2"></span><span class="rc rc3"></span>
  <canvas id="rcanvas"></canvas>
  <div class="sand-note">MOVÉ EL CURSOR: LA ARENA RESPONDE</div>
  <button class="rclose" id="rclose" type="button" aria-label="Cerrar">✕</button>
  <div class="rtext" id="rtext">
    <div class="eyebrow" id="rEyebrow">OCHO VISITAS COMPLETAS</div>
    <h2 id="rTitle">¡Pase gratis!</h2>
    <p id="rSub">Un pase de juego libre, cortesía de Sandy Garden.</p>
    <div class="row">
      <button class="btn" id="rRedeem" type="button">Canjear en recepción</button>
      <button class="btn ghost" id="rLater" type="button">Guardar para después</button>
    </div>
  </div>
</div>

<style is:global>
  .reward-overlay {
    position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; justify-content: center; overflow: hidden;
    background: linear-gradient(180deg, #bcd6dc 0%, #c7dee2 45%, #e6e3d9 100%); animation: fadeIn .6s ease;
  }
  .reward-overlay[hidden] { display: none; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .reward-overlay .sun { position: absolute; width: 60vmin; height: 60vmin; left: 50%; top: 18%; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(255,246,225,.95) 0%, rgba(255,240,210,.45) 30%, rgba(255,240,210,0) 70%); pointer-events: none; }
  .reward-overlay .rc { position: absolute; height: 22px; width: 90px; background: rgba(255,255,255,.9); border-radius: 30px; animation: drift linear infinite; pointer-events: none; left: -260px; }
  .reward-overlay .rc::before, .reward-overlay .rc::after { content: ""; position: absolute; background: rgba(255,255,255,.9); border-radius: 50%; }
  .reward-overlay .rc::before { width: 36px; height: 36px; left: 14px; top: -18px; }
  .reward-overlay .rc::after { width: 26px; height: 26px; left: 44px; top: -12px; }
  .reward-overlay .rc1 { top: 12%; --s: 1.3; animation-duration: 70s; }
  .reward-overlay .rc2 { top: 26%; --s: .9; animation-duration: 95s; animation-delay: -40s; }
  .reward-overlay .rc3 { top: 8%; --s: 1.7; animation-duration: 120s; animation-delay: -80s; opacity: .8; }
  @keyframes drift { from { transform: translateX(0) scale(var(--s, 1)); } to { transform: translateX(calc(100vw + 520px)) scale(var(--s, 1)); } }
  #rcanvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .rclose { position: absolute; top: 18px; right: 18px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255,255,255,.75); color: var(--ink); font-size: 18px; display: grid; place-items: center; z-index: 3; }
  .rtext { position: relative; z-index: 2; text-align: center; padding: 0 20px 7vh; max-width: 760px; opacity: 0; transform: translateY(16px); transition: opacity .9s ease, transform .9s cubic-bezier(.2,.8,.2,1); }
  .rtext.show { opacity: 1; transform: none; }
  .rtext .eyebrow { color: var(--madera-deep); }
  .rtext h2 { font-family: var(--display); font-weight: 400; font-size: clamp(40px, 7vw, 88px); line-height: .98; color: var(--ink); margin: 10px 0 12px; letter-spacing: -.012em; text-wrap: balance; }
  .rtext h2 em { font-style: italic; color: var(--madera-deep); }
  .rtext p { font-family: var(--display); font-size: clamp(18px, 2.2vw, 24px); color: var(--cocoa); margin: 0 0 22px; }
  .rtext .row { justify-content: center; }
  .rtext .btn { background: var(--wood); color: var(--lino); }
  .rtext .btn:hover { background: var(--wood-deep); }
  .rtext .btn.ghost { color: var(--ink); border-color: rgba(51,33,26,.35); background: rgba(255,255,255,.35); }
  .rtext .btn.ghost:hover { background: rgba(255,255,255,.6); }
  .sand-note { position: absolute; left: 50%; top: 20px; transform: translateX(-50%); font-family: var(--hand); font-size: 11px; letter-spacing: .2em; color: rgba(51,33,26,.55); z-index: 2; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    .reward-overlay { animation: none; }
    .reward-overlay .rc { animation: none; left: 20%; }
    .reward-overlay .rc2 { left: 60%; } .reward-overlay .rc3 { left: 80%; }
  }
  @media (pointer: coarse) { .sand-note { display: none; } }
</style>
