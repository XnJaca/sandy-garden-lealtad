---
/** El celular de la familia con la tarjeta estilo Wallet: frente (sellos, premios, QR) y reverso (historial). */
const flor = `<svg viewBox="0 0 60 60" aria-hidden="true"><circle cx="30" cy="30" r="17"/><circle cx="30" cy="12" r="10"/><circle cx="30" cy="48" r="10"/><circle cx="12" cy="30" r="10"/><circle cx="48" cy="30" r="10"/><circle cx="17" cy="17" r="9"/><circle cx="43" cy="17" r="9"/><circle cx="17" cy="43" r="9"/><circle cx="43" cy="43" r="9"/></svg>`;
---
<div class="phone-col" id="phoneCol">
  <div class="phone" id="phone" aria-label="Celular de la familia">
    <div class="screen">
      <div class="island"></div>
      <div class="statusbar">
        <span id="clock">4:06</span>
        <span class="icons" aria-hidden="true">
          <svg width="18" height="12" viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx=".6" fill="#111"/><rect x="5" y="5.5" width="3" height="6.5" rx=".6" fill="#111"/><rect x="10" y="3" width="3" height="9" rx=".6" fill="#111"/><rect x="15" y="0" width="3" height="12" rx=".6" fill="#111"/></svg>
          <svg width="16" height="12" viewBox="0 0 16 12"><path d="M8 11.2 15.4 3.4A10.6 10.6 0 0 0 .6 3.4L8 11.2Z" fill="#111"/></svg>
          <svg width="27" height="13" viewBox="0 0 27 13"><rect x=".5" y=".5" width="23" height="12" rx="3.5" stroke="#111" opacity=".4" fill="none"/><rect x="2" y="2" width="17" height="9" rx="2" fill="#111"/><path d="M25 4.5v4a2 2 0 0 0 0-4Z" fill="#111" opacity=".4"/></svg>
        </span>
      </div>
      <div class="wallet-nav">
        <button type="button" aria-label="Cerrar">✕</button>
        <button type="button" id="flipBtn" aria-label="Ver detalles de la tarjeta">···</button>
      </div>
      <div class="pass-wrap">
        <div class="pass" id="pass">
          <div class="face front">
            <span class="cloud c1"></span><span class="cloud c2"></span><span class="cloud c3"></span>
            <div class="pass-head">
              <img src="/img/logo-h-madera.png" alt="Sandy Garden · sensory playground" width="138" height="40" />
              <div class="pass-field">
                <div class="k">FAMILIA</div>
                <div class="v" id="passName">—</div>
              </div>
            </div>
            <div class="stamps" id="stamps" aria-label="Sellos de visita"></div>
            <div class="pass-progress">
              <div>
                <div class="k" id="progK">VISITAS PARA TU PASE GRATIS</div>
                <div class="n"><span id="progN">8</span><small id="progS"></small></div>
              </div>
              <div class="badges" aria-label="Premios">
                <div class="badge" id="badge10" title="10% en el café a las 4 visitas">
                  <Fragment set:html={flor} />
                  <span><b>10%</b>café</span>
                </div>
                <div class="badge" id="badgeFree" title="Pase de juego libre gratis a las 8 visitas">
                  <Fragment set:html={flor} />
                  <span>Juego<br />libre<br />gratis</span>
                </div>
              </div>
            </div>
            <div class="ready" id="ready">
              <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9h12l-1.6 10.5a1 1 0 0 1-1 .5H8.6a1 1 0 0 1-1-.5L6 9Z" fill="#3a251b"/><path d="M8 9a4 4 0 0 1 8 0" stroke="#3a251b" stroke-width="1.6" fill="none" stroke-linecap="round"/><path d="m14.5 3 2.6 6" stroke="#3a251b" stroke-width="1.6" stroke-linecap="round"/></svg>
              <div><b>¡Tu pase gratis está listo!</b>Mostrá esta pantalla en recepción.</div>
            </div>
            <div class="dunes" aria-hidden="true">
              <svg viewBox="0 0 312 250" preserveAspectRatio="none">
                <path d="M0 150 C 50 110, 110 115, 160 140 S 250 185, 312 150 L312 250 L0 250Z" fill="#e9d9be"/>
                <path d="M0 200 C 70 160, 150 175, 200 195 S 280 215, 312 200 L312 250 L0 250Z" fill="#e5dbcc"/>
              </svg>
            </div>
            <div class="pass-code">
              <canvas class="qr" id="qr" width="132" height="132" aria-label="Código de la tarjeta"></canvas>
              <div class="id" id="passId">SG · 0000</div>
              <div class="hint">Recepción escanea este código</div>
            </div>
          </div>
          <div class="face back">
            <div class="back-in">
              <h3>Detalles de tu tarjeta</h3>
              <dl class="kv">
                <dt>Familia</dt><dd id="bName">—</dd>
                <dt>Peque(s)</dt><dd id="bKids">—</dd>
                <dt>Tarjeta</dt><dd id="bId">—</dd>
                <dt>Con nosotros desde</dt><dd id="bSince">—</dd>
                <dt>Pases gratis usados</dt><dd id="bRedeemed">0</dd>
              </dl>
              <ul class="hist" id="hist"></ul>
              <p class="terms">Un sello por visita por familia. A las 4 visitas, 10% en el café. A las 8, un pase de juego libre gratis. Presentá esta tarjeta en recepción; el nombre debe coincidir con quien la usa.</p>
              <button class="btn paper" id="backBtn" type="button">Volver a la tarjeta</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="phone-note">Lo que ve la familia. Tocá <b>···</b> para ver el historial de visitas.</p>
</div>

<style is:global>
  .phone-col { display: flex; flex-direction: column; align-items: center; gap: 16px; perspective: 1600px; }
  .phone {
    width: 340px; height: 712px; background: #141212; border-radius: 52px; padding: 12px; flex: none; position: relative;
    box-shadow: 0 60px 90px -40px rgba(51,33,26,.75), 0 0 0 2px #2c2828 inset, 0 0 0 1px rgba(255,255,255,.06);
    transform: rotate(-4deg); transition: transform .5s cubic-bezier(.2,.8,.2,1); transform-style: preserve-3d;
  }
  .screen { width: 100%; height: 100%; background: var(--screen); border-radius: 40px; overflow: hidden; position: relative; display: flex; flex-direction: column; }
  .island { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 104px; height: 30px; background: #000; border-radius: 20px; z-index: 5; }
  .statusbar { display: flex; justify-content: space-between; align-items: center; padding: 18px 26px 0; font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; color: #111; }
  .statusbar .icons { display: flex; gap: 6px; align-items: center; }
  .wallet-nav { display: flex; justify-content: space-between; padding: 22px 16px 0; }
  .wallet-nav button { width: 38px; height: 38px; border-radius: 50%; border: 0; background: #fff; color: #111; box-shadow: 0 1px 3px rgba(0,0,0,.08); display: grid; place-items: center; font-size: 18px; }
  .pass-wrap { padding: 16px 14px 0; perspective: 1400px; flex: 1; }
  .pass { position: relative; width: 100%; height: 560px; transform-style: preserve-3d; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .pass.flipped { transform: rotateY(180deg); }
  .face { position: absolute; inset: 0; border-radius: 16px; overflow: hidden; backface-visibility: hidden; background: var(--cielo); color: var(--cocoa); box-shadow: 0 8px 24px -12px rgba(0,0,0,.25); }
  .face.back { transform: rotateY(180deg); background: var(--lino); }

  .pass-head { display: flex; justify-content: space-between; align-items: flex-start; padding: 14px 16px 0; position: relative; z-index: 2; }
  .pass-head img { width: 138px; height: auto; display: block; margin-top: 2px; }
  .pass-field { text-align: right; }
  .pass-field .k { font-family: var(--hand); font-size: 9px; letter-spacing: .14em; color: var(--pizarra-deep); }
  .pass-field .v { font-family: var(--display); font-size: 19px; line-height: 1.1; color: var(--madera-deep); max-width: 130px; margin-left: auto; overflow-wrap: anywhere; }

  .stamps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px 10px; padding: 26px 22px 0; position: relative; z-index: 2; }
  .stamp { aspect-ratio: 1; border-radius: 50%; background: var(--pizarra); position: relative; display: grid; place-items: center; transition: background .3s ease; }
  .stamp svg { width: 62%; height: 62%; opacity: 0; transform: scale(.4) rotate(-18deg); }
  .stamp.on { background: var(--madera-deep); }
  .stamp.on svg { opacity: 1; transform: none; }
  .stamp.pop svg { animation: stampIn .55s cubic-bezier(.2,1.4,.4,1) forwards; }
  .stamp.pop::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--madera); animation: ring .6s ease-out forwards; }
  @keyframes stampIn { 0% { opacity: 0; transform: scale(2.2) rotate(-30deg); } 60% { opacity: 1; transform: scale(.9) rotate(4deg); } 100% { opacity: 1; transform: none; } }
  @keyframes ring { 0% { transform: scale(.6); opacity: 1; } 100% { transform: scale(1.5); opacity: 0; } }

  .pass-progress { padding: 18px 18px 0; position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
  .pass-progress .k { font-family: var(--hand); font-size: 10px; letter-spacing: .14em; color: var(--pizarra-deep); }
  .pass-progress .n { font-family: var(--display); font-size: 44px; line-height: 1; color: var(--madera-deep); font-variant-numeric: tabular-nums; }
  .pass-progress .n small { display: block; font-family: var(--ui); font-size: 12px; line-height: 1.2; color: var(--cocoa-soft); margin-top: 4px; font-weight: 500; }
  .badges { display: flex; gap: 8px; }
  .badge { position: relative; width: 54px; height: 54px; display: grid; place-items: center; }
  .badge svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--pizarra); opacity: .55; transition: fill .3s ease, opacity .3s ease; }
  .badge span { position: relative; font-family: var(--display); font-size: 12px; line-height: 1; text-align: center; color: var(--lino); }
  .badge span b { display: block; font-size: 15px; font-weight: 400; }
  .badge.on svg { fill: var(--madera-deep); opacity: 1; }
  .badge.on { animation: bloom .6s ease; }
  @keyframes bloom { 0% { transform: scale(.8); } 50% { transform: scale(1.12); } 100% { transform: none; } }

  .ready { position: absolute; left: 14px; right: 14px; top: 284px; z-index: 3; background: var(--verde); color: var(--wood-deep); border-radius: 12px; padding: 10px 14px; font-size: 13px; line-height: 1.3; display: none; align-items: center; gap: 10px; box-shadow: 0 8px 20px -10px rgba(90,61,46,.45); }
  .ready.show { display: flex; animation: rise .5s cubic-bezier(.2,.9,.3,1); }
  .ready b { font-family: var(--display); font-size: 16px; font-weight: 400; display: block; }
  @keyframes rise { from { transform: translateY(10px); opacity: 0; } to { transform: none; opacity: 1; } }

  .pass-code { position: absolute; left: 20px; right: 20px; bottom: 16px; z-index: 3; background: #fff; border-radius: 10px; padding: 12px 12px 8px; text-align: center; box-shadow: 0 4px 14px -6px rgba(0,0,0,.18); }
  .pass-code .qr { width: 132px; height: 132px; display: block; margin: 0 auto; }
  .pass-code .id { font-size: 12px; letter-spacing: .12em; color: #333; margin-top: 6px; font-variant-numeric: tabular-nums; }
  .pass-code .hint { font-size: 11px; color: #777; }

  .dunes { position: absolute; left: 0; right: 0; bottom: 0; height: 250px; z-index: 1; pointer-events: none; }
  .dunes svg { width: 100%; height: 100%; display: block; }
  .cloud { position: absolute; width: 34px; height: 12px; background: #fff; border-radius: 12px; opacity: .95; z-index: 1; }
  .cloud::before, .cloud::after { content: ""; position: absolute; background: #fff; border-radius: 50%; }
  .cloud::before { width: 14px; height: 14px; left: 6px; top: -7px; }
  .cloud::after { width: 10px; height: 10px; left: 17px; top: -5px; }
  .cloud.c1 { left: 26px; top: 128px; } .cloud.c2 { right: 22px; top: 62px; transform: scale(.8); } .cloud.c3 { right: 60px; top: 236px; transform: scale(.7); }

  .back-in { padding: 18px 18px 16px; height: 100%; display: flex; flex-direction: column; gap: 14px; overflow: hidden; }
  .back-in h3 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--madera-deep); }
  .kv { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; font-size: 13px; margin: 0; }
  .kv dt { color: var(--cocoa-soft); }
  .kv dd { margin: 0; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .hist { margin: 0; padding: 0; list-style: none; font-size: 13px; overflow: auto; flex: 1; border-top: 1px dashed var(--sand-deep); }
  .hist li { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--sand-deep); }
  .hist li span:last-child { color: var(--cocoa-soft); font-variant-numeric: tabular-nums; }
  .hist li.canje span:first-child { color: var(--verde-deep); font-weight: 600; }
  .hist .empty { color: var(--cocoa-soft); font-style: italic; padding: 10px 0; }
  .terms { font-size: 11px; color: var(--cocoa-soft); line-height: 1.4; margin: 0; }
  .btn.paper { background: transparent; color: var(--madera-deep); border: 1.5px solid var(--sand-deep); padding: 10px 16px; font-size: 14px; align-self: flex-start; }
  .phone-note { font-size: 13px; color: var(--cocoa-soft); text-align: center; max-width: 320px; margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .phone, .pass { transition: none; }
    .stamp.pop svg, .stamp.pop::after, .badge.on, .ready.show { animation: none; }
    .stamp.pop svg { opacity: 1; transform: none; }
  }
  @media (max-width: 960px) { .phone { transform: none; } }
  @media (max-width: 400px) { .phone { width: 100%; max-width: 340px; height: auto; aspect-ratio: 340 / 712; } }
</style>
